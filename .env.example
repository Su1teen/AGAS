# Frontend (both applications must point to the same API).
VITE_AGAS_API_URL=http://localhost:4000
# Backend: use a persistent disk and Node >=24. Do not commit .env.
API_PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SELLER_NAME=
SELLER_ADDRESS=
SELLER_BIN=
SELLER_BANK=
SELLER_IBAN=
SELLER_BIK=
# true blocks preliminary invoices until all genuine seller details are configured.
REQUIRE_SELLER_DETAILS=false
# Empty means VAT unspecified; 0 means explicitly 0%. VAT is added to item prices.
SELLER_VAT_RATE=
# Delivery price in tiyn. 0 means free; confirm this before enabling courier delivery.
DELIVERY_MINOR=0
SMTP_URL=
MAIL_FROM=
